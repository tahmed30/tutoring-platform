{
  "name": "tutoring-platform-infra",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK infrastructure for the tutoring platform",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "deploy:dev": "cdk deploy --all -c env=dev",
    "deploy:staging": "cdk deploy --all -c env=staging",
    "deploy:prod": "cdk deploy --all -c env=prod --require-approval broadening"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.204.0",
    "constructs": "^10.4.2",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.1020.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
