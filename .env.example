# Root summary — copy relevant sections into backend/.env and frontend environment files.

# --- Shared ---
NODE_ENV=development
AWS_REGION=us-east-1

# --- Backend (NestJS) ---
PORT=3000
API_PREFIX=api/v1
DATABASE_URL=postgresql://tutoring:tutoring@localhost:5432/tutoring?schema=public
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-long-random
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4200
S3_BUCKET=tutoring-uploads-dev
USE_DYNAMODB_MESSAGING=false
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_MESSAGES_TABLE=tutoring-messages
DYNAMODB_NOTIFICATIONS_TABLE=tutoring-notifications
UPLOAD_SIGNED_URL_EXPIRES=900
NOTIFICATION_QUEUE_URL=
NOTIFICATIONS_TOPIC_ARN=

# Injected on ECS from Secrets Manager / task env:
# DB_HOST= DB_PORT=5432 DB_NAME=tutoring DB_USERNAME= DB_PASSWORD=

# --- Frontend (Angular) ---
# Use fileReplacements or define in src/environments/
# NG_APP_API_URL=http://localhost:3000/api/v1
# NG_APP_COGNITO_ENABLED=false
# NG_APP_COGNITO_USER_POOL_ID=
# NG_APP_COGNITO_CLIENT_ID=

# --- Per environment (AWS) ---
# dev:     apiDomain=api.dev.tutoring.example.com     aurora ACU 0.5–2
# staging: apiDomain=api.staging.tutoring.example.com aurora ACU 0.5–4
# prod:    apiDomain=api.tutoring.example.com         aurora ACU 1–16
