generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum PreferredLanguage {
  EN
  AM
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum GradeType {
  EXAM
  QUIZ
  HOMEWORK
  PROJECT
  FINAL
}

enum NotificationType {
  INFO
  WARNING
  GRADE_UPDATE
  ATTENDANCE_ALERT
  PAYMENT_REMINDER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

model Role {
  id    String   @id @default(uuid())
  name  RoleName @unique
  users User[]

  @@map("roles")
}

model User {
  id                String            @id @default(uuid())
  firstName         String            @map("first_name")
  lastName          String            @map("last_name")
  email             String            @unique
  phone             String?
  passwordHash      String            @map("password_hash")
  preferredLanguage PreferredLanguage @default(EN) @map("preferred_language")
  roleId            String            @map("role_id")
  role              Role              @relation(fields: [roleId], references: [id])
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  taughtCourses     Course[]          @relation("CourseTeacher")
  enrollments       CourseEnrollment[]
  attendance        Attendance[]
  schedules         ClassSchedule[]
  assignmentsGraded StudentAssignmentSubmission[] @relation("SubmissionGrader")
  submissions       StudentAssignmentSubmission[] @relation("SubmissionStudent")
  grades            Grade[]
  sentMessages      Message[]         @relation("MessageSender")
  receivedMessages  Message[]         @relation("MessageReceiver")
  notifications     Notification[]
  parentLinks       ParentStudent[]   @relation("ParentLink")
  studentLinks      ParentStudent[]   @relation("StudentLink")
  paymentsAsParent  Payment[]         @relation("PaymentParent")
  paymentsAsStudent Payment[]         @relation("PaymentStudent")
  refreshTokens     RefreshToken[]

  @@index([roleId])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)

  @@index([userId])
  @@map("refresh_tokens")
}

model ParentStudent {
  id        String @id @default(uuid())
  parentId  String @map("parent_id")
  studentId String @map("student_id")
  parent    User   @relation("ParentLink", fields: [parentId], references: [id], onDelete: Cascade)
  student   User   @relation("StudentLink", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_student")
}

model Subject {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  courses     Course[]

  @@map("subjects")
}

model Course {
  id          String   @id @default(uuid())
  subjectId   String   @map("subject_id")
  teacherId   String   @map("teacher_id")
  title       String
  description String?
  gradeLevel  String   @map("grade_level")
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  subject     Subject  @relation(fields: [subjectId], references: [id])
  teacher     User     @relation("CourseTeacher", fields: [teacherId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  enrollments CourseEnrollment[]
  attendance  Attendance[]
  schedules   ClassSchedule[]
  assignments Assignment[]
  grades      Grade[]

  @@index([subjectId])
  @@index([teacherId])
  @@map("courses")
}

model CourseEnrollment {
  id             String   @id @default(uuid())
  courseId       String   @map("course_id")
  studentId      String   @map("student_id")
  enrollmentDate DateTime @default(now()) @map("enrollment_date")
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@map("course_enrollment")
}

model Attendance {
  id        String           @id @default(uuid())
  courseId  String           @map("course_id")
  studentId String           @map("student_id")
  date      DateTime         @db.Date
  status    AttendanceStatus
  notes     String?
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([courseId, studentId, date])
  @@index([studentId])
  @@map("attendance")
}

model ClassSchedule {
  id         String    @id @default(uuid())
  courseId   String    @map("course_id")
  teacherId  String    @map("teacher_id")
  dayOfWeek  DayOfWeek @map("day_of_week")
  startTime  String    @map("start_time")
  endTime    String    @map("end_time")
  location   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher    User      @relation(fields: [teacherId], references: [id])

  @@index([courseId])
  @@map("class_schedule")
}

model Assignment {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  dueDate     DateTime @map("due_date")
  maxScore    Float    @map("max_score")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  submissions StudentAssignmentSubmission[]
  grades      Grade[]

  @@index([courseId])
  @@map("assignments")
}

model StudentAssignmentSubmission {
  id                String    @id @default(uuid())
  assignmentId      String    @map("assignment_id")
  studentId         String    @map("student_id")
  submissionFileUrl String?   @map("submission_file_url")
  submittedAt       DateTime  @default(now()) @map("submitted_at")
  grade             Float?
  teacherFeedback   String?   @map("teacher_feedback")
  gradedById        String?   @map("graded_by_id")
  assignment        Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student           User       @relation("SubmissionStudent", fields: [studentId], references: [id])
  gradedBy          User?      @relation("SubmissionGrader", fields: [gradedById], references: [id])

  @@unique([assignmentId, studentId])
  @@map("student_assignment_submissions")
}

model Grade {
  id           String    @id @default(uuid())
  courseId     String    @map("course_id")
  studentId    String    @map("student_id")
  assignmentId String?   @map("assignment_id")
  gradeValue   Float     @map("grade_value")
  gradeType    GradeType @map("grade_type")
  dateRecorded DateTime  @default(now()) @map("date_recorded")
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student      User      @relation(fields: [studentId], references: [id])
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])

  @@index([courseId])
  @@index([studentId])
  @@map("grades")
}

model Message {
  id          String    @id @default(uuid())
  senderId    String    @map("sender_id")
  receiverId  String    @map("receiver_id")
  messageBody String    @map("message_body")
  sentAt      DateTime  @default(now()) @map("sent_at")
  readAt      DateTime? @map("read_at")
  sender      User      @relation("MessageSender", fields: [senderId], references: [id])
  receiver    User      @relation("MessageReceiver", fields: [receiverId], references: [id])

  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  type       NotificationType
  message    String
  createdAt  DateTime         @default(now()) @map("created_at")
  readStatus Boolean          @default(false) @map("read_status")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Payment {
  id            String        @id @default(uuid())
  parentId      String        @map("parent_id")
  studentId     String        @map("student_id")
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("USD")
  paymentMethod String        @map("payment_method")
  paymentDate   DateTime      @default(now()) @map("payment_date")
  status        PaymentStatus @default(PENDING)
  referenceId   String?       @map("reference_id")
  parent        User          @relation("PaymentParent", fields: [parentId], references: [id])
  student       User          @relation("PaymentStudent", fields: [studentId], references: [id])

  @@index([parentId])
  @@index([studentId])
  @@map("payments")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@map("audit_logs")
}
